# Server-side: target for Next.js `/api/v1/*` rewrites (no `/api/v1` suffix).
BACKEND_BASE_URL=http://localhost:5001

# Optional: call the API directly from the browser (skips rewrites). Must be NEXT_PUBLIC_*.
# NEXT_PUBLIC_BACKEND_BASE_URL=https://api.dearlys.in
# Or full API base:
# NEXT_PUBLIC_API_URL=https://api.dearlys.in/api/v1
