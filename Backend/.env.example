PORT=5000
MONGO_URI=
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:3000

CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay — https://dashboard.razorpay.com/app/keys (test keys are free/instant).
# KEY_ID is publishable and is served to the browser by POST /payments/create.
# KEY_SECRET signs and verifies payments; it must stay server-side.
# WEBHOOK_SECRET is set when you add the webhook in the Razorpay dashboard,
# pointing at POST <api>/payments/webhook (events: payment.captured, payment.failed).
# Leave all three blank to place orders without charging: the order is created
# with paymentStatus PENDING and checkout completes without a gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
